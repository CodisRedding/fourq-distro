# Copy this file to .env and fill in after following EBAY_SETUP.md
# The app runs fully without any of this — it's only needed for the
# "Publish to eBay" button to actually create live eBay listings.

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=
EBAY_LOCATION_KEY=
EBAY_CATEGORY_ID=176985
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
PORT=3000

# Discogs — for grade-specific price suggestions (see DISCOGS_SETUP.md).
# Much simpler than eBay: no approval wait, just generate a token and paste it here.
DISCOGS_TOKEN=

# ImgBB — public image hosting so eBay listing photos have a URL it can fetch.
# Free API key from https://api.imgbb.com/ (Keep EXIF data OFF when uploading).
IMGBB_API_KEY=
