# Copy this file to .env and fill in after following EBAY_SETUP.md
# The app runs fully without any of this — it's only needed for the
# "Publish to eBay" button to actually create live eBay listings.

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=
EBAY_LOCATION_KEY=
EBAY_CATEGORY_ID=176985
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
PORT=3000

# Discogs — for grade-specific price suggestions (see DISCOGS_SETUP.md).
# Much simpler than eBay: no approval wait, just generate a token and paste it here.
DISCOGS_TOKEN=

# Cloudinary — public image hosting so eBay/Instagram listing photos have a
# URL those platforms can reliably fetch (see CLOUDINARY_SETUP.md).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Ollama — local vision LLM that flags which uploaded photo shows the dead
# wax/runout area, and reads a new arrival's cover/label photos to fill in
# artist/title/label/etc., instead of a Claude judgment call (see
# OLLAMA_SETUP.md). Optional: both have working defaults and the app runs
# fine with Ollama not installed — both features are just silently skipped.
# Also toggleable in the UI ("Auto-tag runout photos" / "Auto-identify from
# photos" in the toolbar).
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Instagram — posts your listing photos (single image or carousel) + a
# caption via the Instagram API with Instagram Login when you click
# "Publish to Instagram" (see INSTAGRAM_SETUP.md). Reuses the Cloudinary
# credentials above for photo hosting, same as eBay — nothing extra needed
# there. No Facebook Page involved — this app connects directly to the
# Instagram account.
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=
